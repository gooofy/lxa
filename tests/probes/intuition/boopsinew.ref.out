c1 ObjectCount = 0
o_Node.mln_Succ = NULL
-- NewObject(c1)
object = non-NULL
c1: new=1 obj=trueclass 1 obj=ownclass 1 superok 1 dispose=0
c2: new=0 obj=trueclass 0 obj=ownclass 0 superok 0 dispose=0
c1 ObjectCount = 1
dispose c1: new=0 obj=trueclass 0 obj=ownclass 0 superok 0 dispose=1
c1 ObjectCount after = 0
-- DisposeObject(c2 object)
c2: new=0 obj=trueclass 0 obj=ownclass 0 superok 0 dispose=1
c1: new=0 obj=trueclass 0 obj=ownclass 0 superok 0 dispose=1
c2 ObjectCount = 0
FreeClass(c2) = 1
FreeClass(c1) = 1
