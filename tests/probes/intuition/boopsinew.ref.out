c2 InstOffset = 8
c2 InstSize = 12
-- NewObject(c2)
object = non-NULL
c2: new=1 obj=trueclass 1 obj=ownclass 1 superok 1 dispose=0
c1: new=1 obj=trueclass 1 obj=ownclass 0 superok 1 dispose=0
OCLASS == c2 = 1
c1 data = 0x11111111
c2 data = 0x22222222
