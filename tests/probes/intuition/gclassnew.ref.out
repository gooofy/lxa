frame after box=0,0,80x40
-- propgclass
== propgclass default
  gad0 id=0 type=0x0005 flags=0x8004 act=0x0000 box=0,0,80x40 render noselect notext special mx=set
  ext more=0x00000000
  render image0 box=0,0,0x0 depth=0 nodata pick=0x00 onoff=0x00
  propinfo flags=0x0005 hpot=0x0000 vpot=0x0000 hbody=0x0000 vbody=0x0000
  get PGA_Freedom=4 PGA_Top=0
== propgclass vert total visible top newlook
  gad0 id=0 type=0x0005 flags=0x8004 act=0x0001 box=10,10,16x80 render noselect notext special mx=set
  ext more=0x00000000
  render image0 box=0,0,0x0 depth=0 nodata pick=0x00 onoff=0x00
  propinfo flags=0x0015 hpot=0x0000 vpot=0x471c hbody=0x0000 vbody=0x1745
  get PGA_Freedom=4 PGA_Top=25
== propgclass border scroller borderless
  gad0 id=0 type=0x0005 flags=0x8054 act=0x0010 box=-15,12,10x-40 render noselect notext special mx=set
  ext more=0x00000000
  render image0 box=0,0,0x0 depth=0 nodata pick=0x00 onoff=0x00
  propinfo flags=0x001d hpot=0x0000 vpot=0x0000 hbody=0x0000 vbody=0xffff
  get PGA_Freedom=4 PGA_Top=0
== propgclass horiz pot body immediate follow
  gad0 id=0 type=0x0005 flags=0x8004 act=0x000a box=0,0,100x10 render noselect notext special mx=set
  ext more=0x00000000
  render image0 box=0,0,0x0 depth=0 nodata pick=0x00 onoff=0x00
  propinfo flags=0x0003 hpot=0x0000 vpot=0x0000 hbody=0x0000 vbody=0x0000
  get PGA_Freedom=2 PGA_Top=0
== propgclass both knobimage
