-- gadgetclass
== gadgetclass default
  gad0 id=0 type=0x0005 flags=0x8000 act=0x0000 box=0,0,80x40 norender noselect notext nospecial mx=set
  ext more=0x00000000
  get
== gadgetclass box id verify immediate
  gad0 id=7 type=0x0005 flags=0x8000 act=0x0003 box=10,20,30x40 norender noselect notext nospecial mx=set
  ext more=0x00000000
  get
== gadgetclass rel border follow toggle sel dis end
  gad0 id=0 type=0x0005 flags=0x81f8 act=0x011c box=-20,-10,-40x-30 norender noselect notext nospecial mx=set
  ext more=0x00000000
  get
== gadgetclass text tabcycle help border hnone
  gad0 id=0 type=0x0005 flags=0x9203 act=0x00a0 box=0,0,80x40 norender noselect text nospecial mx=set
  ext more=0x00000002
   labelstring="Label"
  get
== gadgetclass itext topborder sysgtype bounds
  gad0 id=0 type=0x0025 flags=0x8000 act=0x0040 box=0,0,80x40 norender noselect text nospecial mx=set
  ext more=0x00000001 box=1,2,300x400
  itext0 t="IText" l=2 tp=3 fp=1 bp=0 dm=0 font=NULL
  itext0 t="IText" l=2 tp=3 fp=1 bp=0 dm=0 font=NULL
  get
