  propinfo flags=0x0007 hpot=0x0000 vpot=0x0000 hbody=0x0000 vbody=0x0000
  get PGA_Freedom=6 PGA_Top=0
-- strgclass
== strgclass default
  gad0 id=0 type=0x0005 flags=0x8000 act=0x2000 box=0,0,80x40 norender noselect notext special mx=set
  ext more=0x00000000
  strinfo max=1 num=0 pos=0 disp=0 long=0 buf=own text="" undo=own ext
  get STRINGA_LongVal=0 STRINGA_TextVal=ptr
== strgclass maxchars textval
  gad0 id=0 type=0x0005 flags=0x8000 act=0x2001 box=10,10,100x12 norender noselect notext special mx=set
  ext more=0x00000000
  strinfo max=40 num=0 pos=0 disp=0 long=0 buf=own text="init" undo=own ext
  get STRINGA_LongVal=0 STRINGA_TextVal=ptr
== strgclass caller buffers bufferpos
  gad0 id=0 type=0x0005 flags=0x8000 act=0x2000 box=0,0,80x40 norender noselect notext special mx=set
  ext more=0x00000000
  strinfo max=64 num=0 pos=2 disp=0 long=0 buf=caller text="hello" undo=caller ext
  get STRINGA_LongVal=0 STRINGA_TextVal=ptr
== strgclass longval right
  gad0 id=0 type=0x0005 flags=0x8000 act=0x2c00 box=0,0,80x40 norender noselect notext special mx=set
  ext more=0x00000000
  strinfo max=10 num=0 pos=0 disp=0 long=1234 buf=own text="1234" undo=own ext
  get STRINGA_LongVal=1234 STRINGA_TextVal=ptr
-- groupgclass
== groupgclass at 10,20
  gad0 id=0 type=0x0005 flags=0x8000 act=0x0000 box=10,20,0x0 norender noselect notext nospecial mx=set
  ext more=0x00000000
  get
addmember 1 = 1
group box=10,20,45x18
  m1 gad0 id=1 type=0x0005 flags=0x9000 act=0x0000 box=15,26,40x12 norender noselect text nospecial mx=set
  m1 ext more=0x00000000
  m1  labelstring="A"
addmember 2 = 1
group box=10,20,90x45
  m2 gad0 id=2 type=0x0005 flags=0x9000 act=0x0000 box=70,50,30x15 norender noselect text nospecial mx=set
  m2 ext more=0x00000000
  m2  labelstring="B"
group next NULL
m1 next NULL
after move group box=100,100,90x45
  m1 gad0 id=1 type=0x0005 flags=0x9000 act=0x0000 box=105,106,40x12 norender noselect text nospecial mx=set
  m1 ext more=0x00000000
  m1  labelstring="A"
  m2 gad0 id=2 type=0x0005 flags=0x9000 act=0x0000 box=160,130,30x15 norender noselect text nospecial mx=set
  m2 ext more=0x00000000
  m2  labelstring="B"
remmember 2 = 1
group box=100,100,90x45
