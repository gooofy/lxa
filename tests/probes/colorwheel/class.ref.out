HSB 0xffffffff 0xffffffff 0xffffffff -> RGB 0xffffffff 0x00000000 0x000c000c
HSB 0x00000000 0x00000000 0xffffffff -> RGB 0xffffffff 0xffffffff 0xffffffff
HSB 0x40000000 0x00000000 0x80000000 -> RGB 0x80008000 0x80008000 0x80008000
HSB 0x40000000 0x80000000 0x80000000 -> RGB 0x60006000 0x80008000 0x3fff3fff
HSB 0x40000000 0xffffffff 0x00000000 -> RGB 0x00000000 0x00000000 0x00000000
HSB 0x12345678 0x9abcdef0 0xfedcba98 -> RGB 0xfedcfedc 0xa68aa68a 0x64cf64cf
HSB 0xc0000000 0x40000000 0xc0000000 -> RGB 0xa7fea7fe 0x8fff8fff 0xc000c000
HSB 0x0fff0fff 0xffffffff 0xffffffff -> RGB 0xffffffff 0x5ffb5ffb 0x00000000
HSB 0x2aa82aa8 0xffffffff 0xffffffff -> RGB 0xffffffff 0xfff3fff3 0x00000000
HSB 0x2aab0000 0xffffffff 0xffffffff -> RGB 0xfffefffe 0xffffffff 0x00000000
HSB 0x40000000 0x7fffffff 0x80000000 -> RGB 0x60006000 0x80008000 0x40004000
HSB 0x854d854d 0x80000000 0xc0000000 -> RGB 0x5fff5fff 0xb414b414 0xc000c000
HSB 0xaff5aff5 0xffffffff 0xffffffff -> RGB 0x1fb61fb6 0x00000000 0xffffffff
HSB 0xfff0fff0 0x12345678 0x9abcdef0 -> RGB 0x9abc9abc 0x8fba8fba 0x8fbf8fbf
-- ConvertRGBToHSB
RGB 0xffffffff 0x00000000 0x00000000 -> HSB 0x00000000 0xffffffff 0xffffffff
RGB 0x00000000 0xffffffff 0x00000000 -> HSB 0x55555555 0xffffffff 0xffffffff
RGB 0x00000000 0x00000000 0xffffffff -> HSB 0xaaaaaaaa 0xffffffff 0xffffffff
RGB 0xffffffff 0xffffffff 0x00000000 -> HSB 0x2aaa2aaa 0xffffffff 0xffffffff
RGB 0x00000000 0xffffffff 0xffffffff -> HSB 0x7fff7fff 0xffffffff 0xffffffff
RGB 0xffffffff 0x00000000 0xffffffff -> HSB 0xd554d554 0xffffffff 0xffffffff
RGB 0xffffffff 0xffffffff 0xffffffff -> HSB (undefined) 0x00000000 0xffffffff
RGB 0x00000000 0x00000000 0x00000000 -> HSB (undefined) 0x00000000 0x00000000
RGB 0x80808080 0x80808080 0x80808080 -> HSB (undefined) 0x00000000 0x80808080
RGB 0xffffffff 0x80000000 0x00000000 -> HSB 0x15551555 0xffffffff 0xffffffff
