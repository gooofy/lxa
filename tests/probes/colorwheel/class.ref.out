RGB 0x66666666 0x88888888 0xbbbbbbbb -> HSB 0x99999999 0x745c745c 0xbbbbbbbb
RGB 0x9380f57d 0xe2d6f703 0xc385e89f -> HSB 0x6f286f28 0x59885988 0xe2d6e2d6
RGB 0x714f6f00 0x78115fd0 0xf1737cb0 -> HSB 0xa869a869 0x87dc87dc 0xf173f173
RGB 0x74ef6bd7 0x6bd7f927 0xf927aaaa -> HSB 0xad69ad69 0x91319131 0xf927f927
RGB 0xc0910000 0x3c970000 0xb2030000 -> HSB 0xda09da09 0xaf72af72 0xc091c091
RGB 0xbc6e0000 0x98b50000 0x00000000 -> HSB 0x22932293 0xffffffff 0xbc6ebc6e
