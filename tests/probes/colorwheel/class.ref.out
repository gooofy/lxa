OpenLibrary colorwheel.gadget same base = TRUE
-- ConvertHSBToRGB
HSB 0x00000000 0xffffffff 0xffffffff -> RGB 0xffffffff 0x00000000 0x00000000
HSB 0x2aaaaaaa 0xffffffff 0xffffffff -> RGB 0xffffffff 0xfffefffe 0x00000000
