-- SameLock/DupLock/ParentDir/NameFromLock
SameLock(file, DupLock) = 0
SameLock(file, dir) = 1
SameLock(ParentDir(file), dir) = 0
DupLock(0) == 0 = TRUE
NameFromLock(file) = ok
NameFromLock(file) tail = "lxaprobe_locks/file1"
