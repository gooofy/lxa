MatchIX "rawmouse lbutton mouse_leftpress" class=0x02 code=0x0068 qual=0x4000 = TRUE
MatchIX "rawmouse lbutton mouse_leftpress" class=0x02 code=0x0068 qual=0xc000 = TRUE
MatchIX "rawmouse mouse_leftpress" class=0x02 code=0x0068 qual=0x4000 = FALSE
MatchIX "rawmouse mouse_leftpress" class=0x02 code=0x0068 qual=0x0000 = TRUE
MatchIX "timer" class=0x06 code=0x0000 qual=0x0000 = TRUE
MatchIX "timer" class=0x06 code=0x0000 qual=0x4000 = FALSE
MatchIX "timer" class=0x01 code=0x0000 qual=0x0000 = FALSE
MatchIX "diskinserted" class=0x10 code=0x0000 qual=0x0000 = TRUE
MatchIX "bogus" class=0x01 code=0x0000 qual=0x0000 = TRUE
MatchIX "" class=0x01 code=0x0000 qual=0x0000 = FALSE
-- MatchIX with hand-made IX
class NULL vs rawkey = TRUE
class NULL vs timer = TRUE
code mask 0xf0, 0x33 vs 0x30 = TRUE
code mask 0xff, 0x33 vs 0x30 = FALSE
qualsame shift: ix lshift vs rshift = FALSE
qualsame shift: ix both vs rshift = TRUE
no qualsame: ix both vs rshift = FALSE
-- done
