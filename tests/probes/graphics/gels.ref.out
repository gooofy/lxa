-- UCopperListInit
result = non-NULL
result==FirstCopList = TRUE
first = count 0 max 2 ptr 0 - current first
ucl.Next = 0
-- CMove/CWait/CBump
after CMove ins0 = op 0 0x0180 0x55aa
after CMove = count 0 max 2 ptr 0 - current first
after CBump = count 1 max 2 ptr 1 - current first
after CWait ins1 = op 1 0x0033 0x0077
after 2nd CBump first = count 2 max 2 ptr 1 next first
first ins1 op = 2
second = count 1 max 16 ptr 1 - current
ins1.nxtlist==second = TRUE
second ins0 = op 1 0x0033 0x0077
second after CMove = count 1 max 16 ptr 1 - current
second after CBump = count 2 max 16 ptr 2 - current
second ins1 = op 0 0x0182 0x0123
after CEND current = count 3 max 16 ptr 3 - current
-- full block
CMove slot1 = op 0 0x0184 0x0abc
after CMove = count 1 max 1 ptr 1 next current first
CWait slot1 = op 1 0x0010 0x0020
after CWait = count 1 max 1 ptr 1 next current first
-- UCopperListInit again
result = non-NULL
same first = TRUE
same CopIns = TRUE
same Next = TRUE
again = count 0 max 3 ptr 0 next current first
