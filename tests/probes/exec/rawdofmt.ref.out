[%-.2s|] -> "xy|\0" n=4 used=4
[%5.0s|] -> "     |\0" n=7 used=4
[%010lx] -> "0000000ABC\0" n=11 used=4
[%-010lx|] -> "ABC       |\0" n=12 used=4
[%010lu|] -> "0000000077|\0" n=12 used=4
[%5u|%-5u|] -> "    7|8    |\0" n=13 used=4
-- positional arguments
[%2$d|%d] -> "1|1\0" n=4 used=2
[%d|%1$d] -> "1|1\0" n=4 used=2
[%d|%3$d|%d] -> "1|2|2\0" n=6 used=4
