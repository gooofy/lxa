[%1$ld|%2$ld] -> "11|22\0" n=6 used=8
[%2$ld|%1$ld] -> "22|11\0" n=6 used=8
[%2$d] -> "1\0" n=2 used=2
[%3$d|%1$d] -> "2|1\0" n=4 used=4
