[%08b|] -> "000hello|\0" n=10 used=4
[%-8b|] -> "hello   |\0" n=10 used=4
[%D|%U|%X|] -> "1|2|0|\0" n=7 used=6
[%S|] -> "S|\0" n=3 used=0
[%C|] -> "C|\0" n=3 used=0
[%B|] -> "B|\0" n=3 used=0
[%lu %lU] -> "1 2\0" n=4 used=8
[%1$d|%2$d] -> "1|2\0" n=4 used=4
