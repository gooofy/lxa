ccr 0x00 d0 12345678 -> 0x12340000 d0 0 -> 0x00000000
ccr 0x01 d0 12345678 -> 0x12340001 d0 0 -> 0x00000001
ccr 0x02 d0 12345678 -> 0x12340002 d0 0 -> 0x00000002
ccr 0x04 d0 12345678 -> 0x12340004 d0 0 -> 0x00000004
ccr 0x08 d0 12345678 -> 0x12340008 d0 0 -> 0x00000008
ccr 0x10 d0 12345678 -> 0x12340010 d0 0 -> 0x00000010
ccr 0x1f d0 12345678 -> 0x1234001f d0 0 -> 0x0000001f
