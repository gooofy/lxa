# lxa RDD reference machine (roadmap "Canonical Reference Configuration")
# Generated by tools/refsys/refctl from lxa-ref.fs-uae.in - do not edit the
# generated copy; never modify the user's Default.fs-uae.
[config]
amiga_model = A4000
cpu = 68040
fpu = 68040
accuracy = -1
jit_compiler = 0
chip_memory = 2048
fast_memory = 0
zorro_iii_memory = 16384
slow_memory = 0
@RTG_CONFIG@
kickstart_file = @KICKSTART@
hard_drive_0 = @SYS@
hard_drive_0_label = System
hard_drive_1 = @APPS@
hard_drive_1_label = APPS
hard_drive_1_read_only = 1
hard_drive_2 = @EXCHANGE@
hard_drive_2_label = LXAREF
serial_port = tcp://127.0.0.1:@SERIAL_PORT@
warp_mode = 1
sound_output = none
joystick_port_0 = none
joystick_port_1 = none
automatic_input_grab = 0
fullscreen = 0
base_dir = @STATE@/base
screenshots_output_dir = @STATE@/shots
logs_dir = @STATE@/logs
