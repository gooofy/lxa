    "requirements": {
        "graphics": true,
        "intuition": true,
        "kickstart_version": 34,
        "profile": "aga"
    },
    "test": {
        "timeout": 10,
        "expected_returncode": 0,
        "args": ""
    },
    "notes": [
        "Configuration file: S:Pascal.config",
        "Migrated from ../lxa-apps/kickpascal2/app.json (DEVS/L/T assigns dropped (they replaced system dirs), FONTS dropped (no fonts dir))"
    ]
