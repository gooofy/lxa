{
    "dir": "kickpascal2",
    "name": "KickPascal 2",
    "version": "2.0",
    "description": "Integrated Pascal development environment",
    "executable": "bin/KP2/KP",
    "kind": "gui",
    "assigns": {
        "KP2": "bin/KP2",
        "KP": "bin/KP2",
        "LIBS": "bin/KP2/libs",
        "S": "bin/KP2/s",
        "KP-DEMOS": "bin/KP2/KP-DEMOS"
    },
    "libraries": [
        "rct.library"
